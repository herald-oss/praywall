# ── Required ─────────────────────────────────────────────────────────
# Matches docker-compose.yml (host port 5437 -> container 5432)
DATABASE_URL=postgresql://praywall:praywall_dev@localhost:5437/praywall
# 32+ random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Production (Railway) ─────────────────────────────────────────────
# Every extra domain that serves the app, comma-separated (sign-out and
# account deletion are rejected from origins not listed here).
# BETTER_AUTH_TRUSTED_ORIGINS=https://praywall.fyi,https://unosporotros.com
# Header that carries the real client IP. Railway sets X-Real-IP (default).
# Use "none" to disable IP-based rate limits.
# TRUSTED_IP_HEADER=x-real-ip
# Railway needs the server to listen on all interfaces.
# HOSTNAME=0.0.0.0

# ── Optional ─────────────────────────────────────────────────────────
# Ko-fi handle for the "Support the ministry" button. Empty hides it.
# NEXT_PUBLIC_KOFI_ID=heraldoss
# Postgres connections per app process (default 5).
# DB_POOL_MAX=5
# Log memory usage every 5 minutes (compare with Railway's metric).
# LOG_MEMORY=1
# Rate limits — see lib/config.ts for every RL_* variable and default.
# RL_INTERCEDE_PER_IP=120
